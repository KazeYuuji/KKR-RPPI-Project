---
import AdminLayout from "../../layouts/AdminLayout.astro";
import StatCard from "../../components/dashboard/StatCard.astro";

const userIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`;
const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>`;
const clockIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`;
const pinIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`;
const ticketIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`;
---

<AdminLayout title="Dashboard">
  <div class="space-y-8 animate-fade-in">
    <!-- Welcome -->
    <div class="rounded-2xl glass-card p-6 sm:p-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-xs font-semibold uppercase tracking-wider text-kkr-maroon/60">Admin Panel</span>
          </div>
          <h2 class="mt-2 text-2xl sm:text-3xl font-semibold text-kkr-dark">Selamat datang, Admin</h2>
          <p class="mt-1 text-sm text-kkr-maroon/80">Kelola pendaftaran, sponsor, dan pengaturan acara KKR RPPI 2026.</p>
        </div>
        <div class="flex gap-3">
          <a href="/#sponsors" target="_blank" class="inline-flex items-center gap-1.5 rounded-xl border border-kkr-light/50 bg-white px-4 py-2.5 text-sm font-semibold text-kkr-maroon shadow-sm transition hover:bg-white hover:border-kkr-light/80">Lihat Sponsor</a>
          <a href="/" target="_blank" class="inline-flex items-center gap-1.5 rounded-xl bg-gradient-to-r from-kkr-maroon to-kkr-red px-4 py-2.5 text-sm font-semibold text-white shadow-sm shadow-kkr-light/50 transition hover:shadow-md hover:shadow-kkr-light/50">Lihat Website</a>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div id="stats-grid" class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      <StatCard label="Total Pendaftar" value="—" icon={userIcon} colorIndex={0} />
      <StatCard label="Sudah Check-in" value="—" icon={checkIcon} colorIndex={1} />
      <StatCard label="Belum Check-in" value="—" icon={clockIcon} colorIndex={2} />
      <StatCard label="Sponsor" value="—" icon={pinIcon} colorIndex={3} />
    </div>

    <!-- Analytics Ringkasan -->
    <div class="grid gap-6 lg:grid-cols-[1fr_1.5fr]">
      <div class="rounded-2xl glass-card p-5 sm:p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-kkr-dark">Distribusi Status</h3>
          <span id="checkin-rate" class="text-xs font-semibold text-kkr-maroon/60">—</span>
        </div>
        <div class="flex items-center gap-4 text-sm mb-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-kkr-red shrink-0"></span>
            <span class="text-kkr-maroon">Check-in</span>
            <span class="font-semibold text-kkr-dark" id="summary-checked">0</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-kkr-gold shrink-0"></span>
            <span class="text-kkr-maroon">Belum</span>
            <span class="font-semibold text-kkr-dark" id="summary-unchecked">0</span>
          </div>
        </div>
        <div class="w-full h-2.5 bg-kkr-light/40 rounded-full overflow-hidden flex">
          <div id="summary-bar-checkin" class="h-full bg-kkr-red transition-all duration-700 rounded-l-full" style="width:0%"></div>
          <div id="summary-bar-unchecked" class="h-full bg-kkr-gold transition-all duration-700 rounded-r-full" style="width:0%"></div>
        </div>
      </div>
      <div class="rounded-2xl glass-card p-5 sm:p-6">
        <h3 class="text-sm font-semibold text-kkr-dark mb-4">Ringkasan Data</h3>
        <div class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm" id="summary-metrics">
          <div class="flex justify-between">
            <span class="text-kkr-maroon">Total Pendaftar</span>
            <span class="font-semibold text-kkr-dark tabular-nums" id="metric-total">—</span>
          </div>
          <div class="flex justify-between">
            <span class="text-kkr-maroon">Check-in Rate</span>
            <span class="font-semibold text-kkr-dark tabular-nums" id="metric-rate">—</span>
          </div>
          <div class="flex justify-between">
            <span class="text-kkr-maroon">Sponsor Aktif</span>
            <span class="font-semibold text-kkr-dark tabular-nums" id="metric-sponsors">—</span>
          </div>
          <div class="flex justify-between">
            <span class="text-kkr-maroon">Pembicara Aktif</span>
            <span class="font-semibold text-kkr-dark tabular-nums" id="metric-speakers">—</span>
          </div>
          <div class="flex justify-between">
            <span class="text-kkr-maroon">Pelayan Altar</span>
            <span class="font-semibold text-kkr-dark tabular-nums" id="metric-altar">—</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Tickets -->
    <div class="rounded-2xl glass-card p-5 sm:p-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="w-8 h-8 rounded-xl bg-kkr-light flex items-center justify-center text-kkr-red" set:html={ticketIcon} />
          <div>
            <h3 class="text-base font-semibold text-kkr-dark">Stok Tiket</h3>
            <p class="text-sm text-kkr-maroon/80">Event gratis — semua tiket tanpa biaya.</p>
          </div>
        </div>
        <a href="/dashboard/tickets" class="inline-flex items-center gap-1.5 text-sm font-medium text-kkr-red hover:text-kkr-red transition-colors shrink-0">
          Kelola Tiket
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
      <div id="ticket-mini-list" class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
    </div>

    <!-- Registrants Table -->
    <div class="rounded-2xl glass-card overflow-hidden">
      <div class="p-5 sm:p-6 border-b border-white/20">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="text-lg font-semibold text-kkr-dark">Daftar Peserta</h3>
            <p class="text-sm text-kkr-maroon/80 mt-0.5">Data peserta yang telah mendaftar</p>
          </div>
          <div class="flex items-center gap-2 flex-wrap">
            <button id="batch-copy-btn" class="inline-flex items-center gap-1.5 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-700 hover:bg-emerald-100 hover:border-emerald-300 transition-colors shadow-sm shrink-0">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              Copy WA & Nama
            </button>
            <a href="/api/registrants/export" class="inline-flex items-center gap-1.5 rounded-xl border border-kkr-light/50 bg-white px-3 py-2 text-xs font-semibold text-kkr-maroon hover:bg-white hover:border-kkr-light/80 transition-colors shadow-sm shrink-0">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Unduh Excel
            </a>
            <div class="relative">
              <input id="search-registrant" type="text" placeholder="Cari nama..." class="w-44 sm:w-52 rounded-xl border border-kkr-light/50 bg-white pl-9 pr-3 py-2 text-sm text-kkr-dark outline-none transition focus:border-kkr-red focus:ring-4 focus:ring-kkr-maroon/20" />
              <svg class="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-kkr-maroon/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
            <span class="shrink-0 inline-flex items-center gap-1.5 text-xs text-emerald-600 bg-emerald-50 px-3 py-1.5 rounded-full font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Live
            </span>
          </div>
        </div>
      </div>
      <div id="registrant-count" class="px-4 sm:px-5 pt-3 pb-1 text-xs text-kkr-maroon/60"></div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-kkr-light/30 text-kkr-dark/70 text-[11px] uppercase tracking-wider">
              <th class="py-2.5 px-3 sm:px-4 font-semibold text-left">Nama</th>
              <th class="py-2.5 px-3 sm:px-4 font-semibold text-left hidden sm:table-cell">ID Tiket</th>
              <th class="py-2.5 px-3 sm:px-4 font-semibold text-left hidden lg:table-cell">Kontak</th>
              <th class="py-2.5 px-3 sm:px-4 font-semibold text-center">Check-in</th>
              <th class="py-2.5 px-3 sm:px-4 font-semibold text-right w-[60px]">Aksi</th>
            </tr>
          </thead>
          <tbody id="registrant-rows" class="divide-y divide-kkr-light/20">
            <tr><td colspan="5" class="py-12 text-center text-kkr-maroon/60 text-sm">Memuat data...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="toast-container" class="fixed top-4 right-4 z-[100] flex flex-col gap-2 pointer-events-none"></div>

  <script type="module">
    function escapeHtml(str) {
      if (str == null) return "";
      return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    function toast(msg, type) {
      if (type == null) type = "success";
      const c = document.getElementById("toast-container");
      const el = document.createElement("div");
      el.className = "pointer-events-auto flex items-center gap-2.5 rounded-xl px-4 py-3 text-sm font-medium shadow-lg transition-all duration-300 animate-slide-up " + (type === "success" ? "bg-emerald-50 text-emerald-800 border border-emerald-200" : "bg-red-50 text-red-800 border border-red-200");
      el.innerHTML = (type === "success" ? '<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>' : '<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>');
      el.appendChild(document.createTextNode(" " + msg));
      c.appendChild(el);
      setTimeout(function() { el.style.opacity = "0"; el.style.transform = "translateX(100%)"; setTimeout(function() { el.remove(); }, 300); }, 3000);
    }

    async function loadStats() {
      try {
        var res = await fetch("/api/stats?_t=" + Date.now());
        var d = await res.json();
        var cards = document.querySelectorAll("#stats-grid > div");
        var tr = d.totalRegistrants || 0;
        var ci = d.checkedIn || 0;
        if (cards.length >= 4) {
          var values = [tr, ci, tr - ci, d.sponsorCount || 0];
          cards.forEach(function(card, i) {
            var valEl = card.querySelector(".text-2xl");
            if (valEl && values[i] !== undefined) {
              var target = values[i];
              var current = 0;
              var step = Math.max(1, Math.floor(target / 30));
              var interval = setInterval(function() {
                current = Math.min(current + step, target);
                valEl.textContent = current;
                if (current >= target) clearInterval(interval);
              }, 30);
            }
          });
        }

        var uc = tr - ci;
        var rate = tr > 0 ? Math.round((ci / tr) * 100) : 0;
        document.getElementById("summary-checked").textContent = ci;
        document.getElementById("summary-unchecked").textContent = uc;
        document.getElementById("checkin-rate").textContent = rate + "% check-in";
        document.getElementById("summary-bar-checkin").style.width = rate + "%";
        document.getElementById("summary-bar-unchecked").style.width = (100 - rate) + "%";
        document.getElementById("metric-total").textContent = tr;
        document.getElementById("metric-rate").textContent = rate + "%";

        try { var r = await fetch("/api/sponsors?_t=" + Date.now()); var rd = await r.json(); document.getElementById("metric-sponsors").textContent = (rd.sponsors || []).filter(function(s){return s.is_active}).length; } catch(e) {}
        try { var r = await fetch("/api/speakers?_t=" + Date.now()); var rd = await r.json(); document.getElementById("metric-speakers").textContent = (rd.speakers || []).filter(function(s){return s.is_active}).length; } catch(e) {}
        try { var r = await fetch("/api/altar-servers?_t=" + Date.now()); var rd = await r.json(); document.getElementById("metric-altar").textContent = (rd.altarServers || []).filter(function(s){return s.is_active}).length; } catch(e) {}
      } catch(e) {}
    }

    var _allRegistrants = [];

    function filterRegistrants() {
      var q = (document.getElementById("search-registrant").value || "").toLowerCase().trim();
      var filtered = q ? _allRegistrants.filter(function(r) { return (r.name || "").toLowerCase().includes(q); }) : _allRegistrants;
      renderRegistrants(filtered);
    }

    function renderRegistrants(list) {
      var tbody = document.getElementById("registrant-rows");
      var countEl = document.getElementById("registrant-count");
      if (!list.length) {
        tbody.innerHTML = '<tr><td colspan="5" class="py-12 text-center text-kkr-maroon/60 text-sm">Belum ada pendaftar.</td></tr>';
        countEl.textContent = "";
        return;
      }
      countEl.textContent = list.length + " peserta";
      tbody.innerHTML = list.map(function(r) {
        var name = escapeHtml(r.name || "Tanpa Nama");
        var initial = escapeHtml((r.name || "?").charAt(0).toUpperCase());
        var ticketType = escapeHtml(r.ticket || "-");
        var ticketId = escapeHtml(String(r.id));
        var email = escapeHtml(r.email || "");
        var wa = escapeHtml(r.whatsapp || "");
        var color = (r.name || "").split("").reduce(function(a, c) { return a + c.charCodeAt(0); }, 0) % 360;
        var avatarBg = "hsl(" + color + ", 35%, 60%)";
        var isChecked = r.checked_in;
        var contactHtml = '';
        if (email) contactHtml += '<a href="mailto:' + email + '" class="inline-flex items-center gap-1 text-xs text-kkr-maroon/65 hover:text-kkr-red transition-colors" title="' + email + '"><svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>Email</a>';
        if (wa) {
          var waNum = wa.replace(/[^0-9]/g, "");
          if (contactHtml) contactHtml += '<span class="mx-1.5 text-kkr-light/40">|</span>';
          contactHtml += '<a href="https://wa.me/' + waNum + '" target="_blank" class="inline-flex items-center gap-1 text-xs text-emerald-600 hover:text-emerald-700 transition-colors" title="' + wa + '"><svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>WA</a>';
        }
        if (!contactHtml) contactHtml = '<span class="text-xs text-kkr-maroon/35">—</span>';

        var statusDot = isChecked ? "bg-emerald-500" : "bg-kkr-light/50";
        var statusLabel = isChecked ? "Checked-in" : "Belum";

        return '<tr class="hover:bg-white/40 transition-colors">' +
          '<td class="py-3 px-3 sm:px-4"><div class="flex items-center gap-2.5"><div class="w-7 h-7 rounded-full flex items-center justify-center text-[11px] font-bold text-white shrink-0" style="background:' + avatarBg + '">' + initial + '</div><div class="min-w-0"><div class="font-medium text-kkr-dark text-sm truncate">' + name + '</div><div class="text-[11px] text-kkr-maroon/55">' + ticketType + '</div></div></div></td>' +
          '<td class="py-3 px-3 sm:px-4 hidden sm:table-cell"><div class="font-mono text-xs text-kkr-dark select-all bg-kkr-light/20 rounded-md px-2 py-1 inline-block">' + ticketId + '</div><button data-copy="' + ticketId + '" class="ml-1 rounded-md px-1.5 py-1 text-kkr-maroon/40 hover:text-kkr-red hover:bg-kkr-light/30 transition align-middle active:scale-90" title="Salin"><svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></td>' +
          '<td class="py-3 px-3 sm:px-4 hidden lg:table-cell"><div class="flex flex-wrap items-center gap-x-1">' + contactHtml + '</div></td>' +
          '<td class="py-3 px-3 sm:px-4 text-center"><div class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full ' + statusDot + '"></span><span class="text-xs font-medium ' + (isChecked ? 'text-emerald-700' : 'text-kkr-maroon/50') + '">' + statusLabel + '</span></div></td>' +
          '<td class="py-3 px-3 sm:px-4 text-right"><div class="flex items-center justify-end gap-0.5">' + (isChecked ? '' : '<button data-action="checkin" data-id="' + ticketId + '" class="rounded-lg p-1.5 text-xs font-semibold transition bg-emerald-50 text-emerald-600 hover:bg-emerald-100 active:scale-90" title="Check-in"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></button>') + '<button data-action="delete" data-id="' + ticketId + '" class="rounded-lg p-1.5 text-xs font-semibold transition bg-red-50 text-red-400 hover:bg-red-100 hover:text-red-600 active:scale-90" title="Hapus"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button></div></td>' +
          '</tr>';
      }).join("");
    }

    async function loadRegistrants() {
      try {
        var res = await fetch("/api/registrants?_t=" + Date.now());
        var d = await res.json();
        _allRegistrants = d.registrants || [];
        filterRegistrants();
      } catch(e) {}
    }

    async function loadTickets() {
      try {
        var res = await fetch("/api/tickets?_t=" + Date.now());
        var d = await res.json();
        var container = document.getElementById("ticket-mini-list");
        var list = d.tickets || [];
        container.innerHTML = list.map(function(t) {
          return '<div class="flex items-center justify-between rounded-xl border border-kkr-light/30 bg-white/50 p-3.5 transition hover:border-kkr-light/50">' +
            '<div class="flex items-center gap-3"><div class="w-2 h-2 rounded-full ' + (t.remaining > 0 ? 'bg-emerald-400' : 'bg-red-400') + '"></div><div><p class="text-sm font-semibold text-kkr-dark">' + escapeHtml(t.name) + '</p><p class="text-xs text-kkr-maroon/80 mt-0.5">Sisa: ' + t.remaining + ' tiket</p></div></div>' +
            '<span class="text-xs font-semibold px-2.5 py-1 rounded-full ' + (t.remaining > 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-700') + '">' + (t.remaining > 0 ? 'Tersedia' : 'Habis') + '</span></div>';
        }).join("");
      } catch(e) {}
    }

    document.getElementById("registrant-rows")?.addEventListener("click", async function(e) {
      var btn = e.target.closest("button[data-action]");
      if (btn) {
        var id = btn.dataset.id;
        var action = btn.dataset.action;
        if (action === "delete") {
          if (!confirm("Hapus peserta ini? Tiket akan dikembalikan ke stok.")) return;
          try {
            var res = await fetch("/api/registrants/" + id, { method: "DELETE" });
            if (res.ok) { loadRegistrants(); loadStats(); loadTickets(); toast("Peserta dihapus, tiket dikembalikan"); }
            else { var d = await res.json(); toast(d.error || "Gagal menghapus", "error"); }
          } catch(e) { toast("Gagal menghapus", "error"); }
          return;
        }
        try {
          var res = await fetch("/api/registrants", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: id, action: "checkin" }) });
          if (res.ok) { loadRegistrants(); loadStats(); toast("Check-in berhasil!"); }
          else { var d = await res.json(); toast(d.error || "Gagal", "error"); }
        } catch(e) { toast("Gagal check-in", "error"); }
        return;
      }
      var copyBtn = e.target.closest("button[data-copy]");
      if (copyBtn) {
        var id = copyBtn.getAttribute("data-copy");
        try { await navigator.clipboard.writeText(id); } catch {
          var ta = document.createElement("textarea");
          ta.value = id; ta.style.position = "fixed"; ta.style.opacity = "0";
          document.body.appendChild(ta); ta.select();
          document.execCommand("copy"); document.body.removeChild(ta);
        }
        toast("ID tiket disalin: " + id);
      }
    });

    document.getElementById("search-registrant")?.addEventListener("input", filterRegistrants);

    document.getElementById("batch-copy-btn")?.addEventListener("click", async function() {
      var list = _allRegistrants;
      if (!list.length) { toast("Belum ada data peserta", "error"); return; }
      var lines = list.map(function(r) {
        var wa = (r.whatsapp || "").replace(/[^0-9]/g, "");
        var name = r.name || "Tanpa Nama";
        return wa ? wa + " - " + name : name;
      });
      var text = lines.join("\n");
      try { await navigator.clipboard.writeText(text); } catch {
        var ta = document.createElement("textarea");
        ta.value = text; ta.style.position = "fixed"; ta.style.opacity = "0";
        document.body.appendChild(ta); ta.select();
        document.execCommand("copy"); document.body.removeChild(ta);
      }
      toast("Disalin " + list.length + " data (WA - Nama)");
    });

    async function pollAll() {
      await Promise.allSettled([loadStats(), loadRegistrants(), loadTickets()]);
      setTimeout(pollAll, 10000);
    }

    document.addEventListener("DOMContentLoaded", function() { loadStats(); loadRegistrants(); loadTickets(); setTimeout(pollAll, 10000); });
  </script>
</AdminLayout>
