# PostgreSQL (WAJIB diisi - app akan crash jika tidak ada)
PGHOST=postgresql
PGPORT=5432
PGUSER=kediritechnopark
PGPASSWORD=your-password
PGDATABASE=kkr_rppi

# MinIO S3-compatible storage (untuk file upload, opsional jika hanya ada upload gambar)
MINIO_ENDPOINT=http://cdn.kediritechnopark.com:9002
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=kkr-rppi

# JWT secret for admin authentication (generate with: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-random-64-char-hex-string

# Google Gemini AI API Key (free: https://aistudio.google.com/apikey)
# Jika tidak diisi, chatbot akan menggunakan mode pintar tanpa AI
GEMINI_API_KEY=
